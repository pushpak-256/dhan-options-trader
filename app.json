{
  "expo": {
    "name": "Dhan Options Trader",
    "slug": "dhan-options-trader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antigravity.dhantrader"
    },
    "android": {
      "package": "com.antigravity.dhantrader",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "REQUEST_INSTALL_PACKAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Dhan Options Trader",
      "shortName": "DhanTrader",
      "description": "Options Trading Terminal with Visual Chart Orders & Risk Guardrails",
      "display": "standalone",
      "themeColor": "#0B1120",
      "backgroundColor": "#0F172A",
      "orientation": "portrait"
    }
  }
}
